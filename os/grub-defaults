GRUB_DEFAULT=0
GRUB_TIMEOUT=2
GRUB_DISTRIBUTOR="Mini Core"
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1"
GRUB_CMDLINE_LINUX="rw init=/usr/sbin/tiny-init console=tty0 console=ttyS0,115200n8 net.ifnames=0 biosdevname=0"
GRUB_DISABLE_OS_PROBER=true
